// Cloudflare Workers deployment: a static-assets Worker (no server code).
// `npm run deploy` builds the site into dist/ and uploads it; Cloudflare
// serves it from the edge. Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skin-hangar",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    // the whole app is index.html; unknown paths fall back to it
    "not_found_handling": "single-page-application"
  }
}
